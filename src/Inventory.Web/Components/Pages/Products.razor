@page "/products"
@inject InventoryApiClient Api
@inject IJSRuntime Js

<PageTitle>Products · Northline</PageTitle>

<section class="page">
    <header class="page-head">
        <div>
            <p class="eyebrow">Catalog</p>
            <h1>Products</h1>
            <p class="lede">Quantity changes only through a stock movement. Archiving hides a SKU and keeps its history.</p>
        </div>
        <a class="button" href="/products/new">New product</a>
    </header>

    <form class="filters" @onsubmit="Search" @onsubmit:preventDefault>
        <label>
            Search
            <input @bind="_search" @bind:event="oninput" placeholder="SKU or name" />
        </label>
        <label class="check">
            <input type="checkbox" @bind="_includeArchived" />
            Show archived
        </label>
        <button class="button secondary" type="submit">Search</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="banner" role="alert">@_error</p>
    }

    @if (_loading)
    {
        <p class="status">Loading products…</p>
    }
    else if (_page is null || _page.Items.Count == 0)
    {
        <p class="empty">No products match this view.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th scope="col">SKU</th>
                        <th scope="col">Name</th>
                        <th scope="col" class="num">On hand</th>
                        <th scope="col" class="num">Reorder</th>
                        <th scope="col" class="num">Price</th>
                        <th scope="col">Status</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in _page.Items)
                    {
                        <tr>
                            <td class="sku">@product.Sku</td>
                            <td>@product.Name</td>
                            <td class="num">@product.QuantityOnHand</td>
                            <td class="num">@product.ReorderLevel</td>
                            <td class="num">@CatalogFormat.Money(product.UnitPrice)</td>
                            <td>
                                @if (!product.IsActive)
                                {
                                    <span class="badge mute">Archived</span>
                                }
                                else if (product.IsLowStock)
                                {
                                    <span class="badge bad">Low</span>
                                }
                                else
                                {
                                    <span class="badge ok">In stock</span>
                                }
                            </td>
                            <td class="row-actions">
                                <a href="@($"/products/{product.Id}")">Edit</a>
                                @if (product.IsActive)
                                {
                                    <button type="button" class="text-button" @onclick="() => Archive(product)">Archive</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pager">
            <p>Showing @FirstRow–@LastRow of @_page.TotalCount</p>
            <div>
                <button type="button" class="button secondary" disabled="@(_page.Page <= 1)" @onclick="Previous">Previous</button>
                <button type="button" class="button secondary" disabled="@(LastRow >= _page.TotalCount)" @onclick="Next">Next</button>
            </div>
        </div>
    }
</section>

@code {
    private const int PageSize = 8;
    private PagedProducts? _page;
    private string _search = string.Empty;
    private bool _includeArchived;
    private int _pageNumber = 1;
    private bool _loading = true;
    private string? _error;

    private int FirstRow => _page is null || _page.TotalCount == 0 ? 0 : ((_page.Page - 1) * _page.PageSize) + 1;

    private int LastRow => _page is null ? 0 : Math.Min(_page.Page * _page.PageSize, _page.TotalCount);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task Search()
    {
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task Previous()
    {
        if (_pageNumber > 1)
        {
            _pageNumber--;
            await LoadAsync();
        }
    }

    private async Task Next()
    {
        _pageNumber++;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _page = await Api.GetProductsAsync(_search, _includeArchived, _pageNumber, PageSize);
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
        catch (HttpRequestException)
        {
            _error = "The inventory API is not reachable. Start Inventory.Api, then reload this page.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Archive(ProductModel product)
    {
        var confirmed = await Js.InvokeAsync<bool>("confirm", $"Archive {product.Sku}? Its movement history stays.");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await Api.ArchiveProductAsync(product.Id);
            await LoadAsync();
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
    }
}
