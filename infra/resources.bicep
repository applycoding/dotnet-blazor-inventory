@description('Azure region for the demo resources.')
param location string

@description('Short lowercase prefix. Defaults are generated by main.bicep.')
param namePrefix string

@description('Tags applied to every resource. Include azd-env-name when using Azure Developer CLI.')
param tags object = {}

@description('SQL administrator login for this demo database.')
param sqlAdminLogin string

@secure()
@description('SQL administrator password. Supply this at deploy time. Do not commit it.')
param sqlAdminPassword string

@secure()
@minLength(32)
@description('JWT signing key of at least 32 characters. Supply this at deploy time.')
param jwtSigningKey string

var prefix = toLower(namePrefix)
var planName = '${prefix}-plan'
var apiName = take('${prefix}-api', 60)
var webName = take('${prefix}-web', 60)
var sqlServerName = take('${prefix}sql', 63)

resource plan 'Microsoft.Web/serverfarms@2023-12-01' = {
  name: planName
  location: location
  tags: tags
  sku: {
    name: 'B1'
    tier: 'Basic'
  }
  kind: 'linux'
  properties: {
    reserved: true
  }
}

resource sqlServer 'Microsoft.Sql/servers@2023-08-01-preview' = {
  name: sqlServerName
  location: location
  tags: tags
  properties: {
    administratorLogin: sqlAdminLogin
    administratorLoginPassword: sqlAdminPassword
    minimalTlsVersion: '1.2'
    publicNetworkAccess: 'Enabled'
  }
}

resource allowAzure 'Microsoft.Sql/servers/firewallRules@2023-08-01-preview' = {
  parent: sqlServer
  name: 'AllowAzureServices'
  properties: {
    startIpAddress: '0.0.0.0'
    endIpAddress: '0.0.0.0'
  }
}

resource database 'Microsoft.Sql/servers/databases@2023-08-01-preview' = {
  parent: sqlServer
  name: 'inventory'
  location: location
  tags: tags
  sku: {
    name: 'Basic'
    tier: 'Basic'
  }
  properties: {
    collation: 'SQL_Latin1_General_CP1_CI_AS'
    maxSizeBytes: 2147483648
  }
}

var sqlConnection = 'Server=tcp:${sqlServer.properties.fullyQualifiedDomainName},1433;Initial Catalog=${database.name};User ID=${sqlAdminLogin};Password=${sqlAdminPassword};Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;'

resource api 'Microsoft.Web/sites@2023-12-01' = {
  name: apiName
  location: location
  tags: union(tags, { 'azd-service-name': 'api' })
  kind: 'app,linux'
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    siteConfig: {
      linuxFxVersion: 'DOTNETCORE|8.0'
      ftpsState: 'Disabled'
      minTlsVersion: '1.2'
      healthCheckPath: '/health'
      appSettings: [
        { name: 'ASPNETCORE_ENVIRONMENT', value: 'Production' }
        { name: 'Database__Provider', value: 'SqlServer' }
        { name: 'Database__ConnectionString', value: sqlConnection }
        { name: 'Jwt__Issuer', value: 'northline-inventory' }
        { name: 'Jwt__Audience', value: 'northline-inventory' }
        { name: 'Jwt__SigningKey', value: jwtSigningKey }
        { name: 'Jwt__ExpiryMinutes', value: '480' }
        { name: 'Seed__Enabled', value: 'true' }
      ]
    }
  }
}

resource web 'Microsoft.Web/sites@2023-12-01' = {
  name: webName
  location: location
  tags: union(tags, { 'azd-service-name': 'web' })
  kind: 'app,linux'
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    siteConfig: {
      linuxFxVersion: 'DOTNETCORE|8.0'
      ftpsState: 'Disabled'
      minTlsVersion: '1.2'
      appSettings: [
        { name: 'ASPNETCORE_ENVIRONMENT', value: 'Production' }
        { name: 'Api__BaseUrl', value: 'https://${api.properties.defaultHostName}/' }
      ]
    }
  }
}

output apiName string = api.name
output webName string = web.name
output apiUrl string = 'https://${api.properties.defaultHostName}'
output webUrl string = 'https://${web.properties.defaultHostName}'
output sqlServerFqdn string = sqlServer.properties.fullyQualifiedDomainName
